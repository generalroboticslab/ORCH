# Dockerfile for WILDFIRE Algorithm Service (GPU Version)
FROM nvidia/cuda:11.8.0-runtime-ubuntu22.04

# Set working directory
WORKDIR /app

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install Python and system dependencies for Unity GPU rendering
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3.10-venv \
    python3-pip \
    build-essential \
    git \
    libglu1-mesa \
    libgl1-mesa-glx \
    libxcursor1 \
    libxinerama1 \
    libxrandr2 \
    libxi6 \
    libx11-6 \
    libxext6 \
    libxkbcommon0 \
    libasound2 \
    libpulse0 \
    && rm -rf /var/lib/apt/lists/*

# Make python3.10 the default python
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1 && \
    update-alternatives --install /usr/bin/pip pip /usr/bin/pip3 1

# NVIDIA environment variables for GPU rendering in containers
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=graphics,compute,utility

# Copy requirements file from working environment
COPY crew-algorithms/requirements-full.txt ./

# Clean up requirements file to remove problematic dependencies and install
RUN sed -i '/@ file:/d' requirements-full.txt && \
    sed -i '/^-e git+/d' requirements-full.txt && \
    sed -i '/@ git+/d' requirements-full.txt && \
    sed -i '/PyAudio/d' requirements-full.txt && \
    sed -i '/tensordict/d' requirements-full.txt && \
    sed -i '/torchrl/d' requirements-full.txt && \
    pip install --no-cache-dir -r requirements-full.txt && \
    pip install --no-cache-dir tensordict==0.3.0 torchrl==0.3.0 && \
    PIP_NO_BUILD_ISOLATION=0 pip install --no-cache-dir --ignore-requires-python git+https://github.com/lingyu98/ml-agents.git#subdirectory=ml-agents-envs && \
    pip install --no-cache-dir git+https://github.com/openai/whisper.git

# Copy wildfire_alg requirements and install additional dependencies
COPY crew-algorithms/crew_algorithms/wildfire_alg/requirements.txt ./wildfire_requirements.txt
RUN pip install --no-cache-dir -r wildfire_requirements.txt

# Copy the entire crew-dev directory structure (filtered by .dockerignore)
COPY . /app/

# Set Python path
ENV PYTHONPATH=/app

# Create necessary directories
RUN mkdir -p /app/results/logs/WILDFIRE

# Expose port
EXPOSE 8001

# Command to run the algorithm service
# GPU rendering uses the host's X server via volume mount
CMD ["python", "crew-algorithms/crew_algorithms/wildfire_alg/algorithm_service.py"]
