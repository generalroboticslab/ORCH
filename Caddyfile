crew-wildfire.com, www.crew-wildfire.com {
    # Block CVE-2025-29927 exploit header
    request_header -x-middleware-subrequest
    request_header -x-middleware-invoke

    # Block Next.js debug endpoints
    @blocked path /__nextjs_original-stack-frames*
    handle @blocked {
        respond 403
    }

    # Backend API
    handle_path /api/* {
        reverse_proxy backend:8000
    }

    # Nakama game server (WebSocket support included)
    handle_path /nakama/* {
        reverse_proxy nakama:7350
    }

    # Frontend (default route)
    reverse_proxy frontend:3000
}
