# Dockerfile context from CREW-dev root for algorithm container
# Exclude everything except necessary crew-algorithms components and Unity builds

# Exclude all by default
*

# Include only crew-algorithms and crew-dojo/Builds
!crew-algorithms/
!crew-dojo/
crew-dojo/*
!crew-dojo/Builds/

# Narrow to only the needed crew_algorithms subdirs
crew-algorithms/crew_algorithms/*/
!crew-algorithms/crew_algorithms/wildfire_alg/
!crew-algorithms/crew_algorithms/envs/
!crew-algorithms/crew_algorithms/utils/
!crew-algorithms/crew_algorithms/conf/
!crew-algorithms/crew_algorithms/__init__.py

# Now that includes are settled, exclude junk at any depth.
# These rules come AFTER the re-includes so they win.
crew-algorithms/**/experiment_data/
crew-algorithms/**/results/
crew-algorithms/**/logs/
crew-algorithms/**/past_logs/
crew-algorithms/**/render/
crew-algorithms/**/output/
crew-algorithms/**/outputs/
crew-algorithms/**/__pycache__/
crew-algorithms/**/.pytest_cache/
crew-algorithms/**/venv/
crew-algorithms/**/env/
crew-algorithms/**/ENV/
crew-algorithms/**/build/
crew-algorithms/**/dist/
crew-algorithms/**/*.egg-info/
crew-algorithms/**/.vscode/
crew-algorithms/**/.idea/
crew-algorithms/**/.git/
crew-algorithms/**/.gitignore
crew-algorithms/**/.ipynb_checkpoints/
crew-algorithms/**/*.pyc
crew-algorithms/**/*.pyo
crew-algorithms/**/*.pyd
crew-algorithms/**/*.log
crew-algorithms/**/*.mp4
crew-algorithms/**/*.png
crew-algorithms/**/*.jpg
crew-algorithms/**/*.jpeg
crew-algorithms/**/*.csv
crew-algorithms/**/*.ipynb
crew-algorithms/**/*.swp
crew-algorithms/**/*.swo

# Exclude everything else
wildfire-human-interface/
*.md
*.json
!crew-algorithms/crew_algorithms/wildfire_alg/requirements.txt
